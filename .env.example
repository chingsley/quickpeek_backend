# ─────────────────────────────────────────────────────────────────────────────
# QuickPeek backend environment
# Copy this file to `.env` and fill in the values. `.env` is git-ignored —
# never commit real keys. For staging/production hosting, see STAGING.md at
# the repo root.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://username:password@localhost:5432/quickpeek_db
# Used by the Jest suites (npm run migrate:init:test / migrate:reset:test).
DATABASE_URL_TEST=postgresql://username:password@localhost:5432/quickpeek_test
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=30d
BCRYPT_SALT_ROUND=10

# ── Redis (Bull queues + nearby-questions cache) ─────────────────────────────
# Local development: host/port pair.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Hosted providers (Render Key Value, etc.) hand out ONE connection string
# instead — set REDIS_URL and it wins over the host/port pair.
# Use the provider's *internal* URL (redis://...). rediss:// enables TLS,
# which external connections usually require.
# REDIS_URL=redis://red-xxxx:6379

# ── App URLs ──────────────────────────────────────────────────────────────────
# Public origin of the WEB frontend (browser client). Used for socket.io CORS
# when NODE_ENV=production, and as the fallback handoff URL for Stripe payout
# onboarding when the app doesn't pass its own deep link. The Stripe return
# page itself is built from request headers, so this does NOT need to be the
# API's URL. Native-only deployments: any placeholder is fine.
FRONTEND_URL=http://localhost:8081
QUESTION_DRAFT_TTL_HOURS=24

# ── Push notifications ────────────────────────────────────────────────────────
# Push goes through the Expo Push API (see src/common/utils/push.ts) and needs
# NO backend env vars — the app collects an Expo push token at sign-in and cold
# start, and EAS attaches Apple credentials at build time.
# FIREBASE_CREDENTIAL_PATH below is a legacy/unused path (the Firebase admin
# helper is not called by any live code) and can be left empty.
FIREBASE_CREDENTIAL_PATH=

# ── Cloudinary (image uploads) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Payments: Stripe (default provider, US/EU/global) ────────────────────────
# Both come from https://dashboard.stripe.com (free account; test mode is
# free and needs no business verification):
#   0. FIRST: activate Connect or every payout-setup call fails with
#      "You can only create new accounts if you've signed up for Connect":
#      switch to TEST mode (toggle top-right), open
#      https://dashboard.stripe.com/connect → "Get started", and complete the
#      platform questionnaire (marketplace/platform answers are fine; it's
#      instant in test mode).
#   STRIPE_SECRET_KEY:
#     Dashboard → Developers → API keys → "Secret key"
#     (use the test-mode key, sk_test_..., while developing/staging).
#     The matching publishable key (pk_test_...) goes in the FRONTEND env —
#     the backend never reads it.
#   STRIPE_WEBHOOK_SECRET:
#     Local dev: install the Stripe CLI, then run
#       stripe listen --forward-to localhost:3000/api/v1/payments/webhooks/stripe
#     and copy the printed `whsec_...` (it changes per CLI session).
#     Staging/production: Dashboard → Developers → Webhooks → Add endpoint
#       URL: https://<your-api-host>/api/v1/payments/webhooks/stripe
#       Events: payment_intent.succeeded, payment_intent.payment_failed,
#               account.updated
#     then copy the endpoint's "Signing secret".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Payments: Paystack (West Africa) ─────────────────────────────────────────
# From https://dashboard.paystack.com (free account; test mode is free):
#   Settings → API Keys & Webhooks → copy the test "Secret key".
#   The same secret key verifies webhook signatures.
#   Also register the webhook URL in that same settings page:
#     https://<your-api-host>/api/v1/payments/webhooks/paystack
#   (event used: charge.success)
#   The public key is used client-side (Paystack WebView) — the backend never
#   reads it.
PAYSTACK_SECRET_KEY=
# Optional override for the URL Paystack redirects to after checkout. The app
# only pattern-matches the path, so the default works out of the box.
# PAYSTACK_CALLBACK_URL=https://payments.quickpeek.local/paystack/callback
