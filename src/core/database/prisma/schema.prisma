generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String         @id @default(uuid())
  email                  String         @unique
  password               String
  name                   String
  username               String         @unique
  deviceType             String
  deviceToken            String
  notificationsEnabled   Boolean
  locationSharingEnabled Boolean
  isVerified             Boolean
  isAdmin                Boolean        @default(false)
  profileImageUrl        String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  location         Location?
  questions        Question[]     @relation("CreatedQuestions")
  messages         Message[]
  reviewsGiven     Review[]       @relation("ReviewsGiven")
  reviewsReceived  Review[]       @relation("ReviewsReceived")
  userRatings      UserRating[]
  requestsMade     AnswerRequest[] @relation("RequestsByResponder")
  requestsReceived AnswerRequest[] @relation("RequestsForQuestioner")
  responderBlocks  QuestionResponderBlock[] @relation("ResponderBlocks")
  paymentAccount   PaymentAccount?
  paymentsMade     Transaction[]  @relation("PaymentsMade")
  paymentsReceived Transaction[]  @relation("PaymentsReceived")

  @@map("users")
}

model Location {
  id        String   @id @default(uuid())
  userId    String   @unique
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("locations")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  questions Question[]

  @@map("categories")
}

enum QuestionStatus {
  OPEN
  CLOSED
}

enum ReviewerRole {
  QUESTIONER
  RESPONDER
}

enum RatingRole {
  AS_RESPONDER
  AS_QUESTIONER
}

enum MessageType {
  USER
  SYSTEM
}

enum AnswerRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CLOSED_ANSWERED
}

/// Who may respond to a question, derived from its location intent.
/// The numeric radius for each tier is resolved live from market_configs
/// (see locationScope.utils.ts); ANYWHERE disables distance gating.
enum LocationScope {
  AT_EXACT_ADDRESS
  WALKING
  NEIGHBOURHOOD
  CITY
  ANYWHERE
}

model Question {
  id                  String         @id @default(uuid())
  title               String
  detail              String
  categoryId          String
  price               Float
  acceptanceCriteria  String
  latitude            Float?
  longitude           Float?
  address             String?
  locationScope       LocationScope  @default(ANYWHERE)
  userId              String
  status              QuestionStatus @default(OPEN)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  answeredAt          DateTime?
  closedAt            DateTime?
  closeReason         String?

  category   Category       @relation(fields: [categoryId], references: [id])
  user       User           @relation("CreatedQuestions", fields: [userId], references: [id], onDelete: Cascade)
  messages         Message[]
  requests         AnswerRequest[]
  responderBlocks  QuestionResponderBlock[]
  transactions     Transaction[]

  @@index([categoryId])
  @@index([status])
  @@map("questions")
}

model AnswerRequest {
  id              String             @id @default(uuid())
  questionId      String
  responderId     String
  questionerId    String
  status          AnswerRequestStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime           @default(now())
  respondedAt     DateTime?

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responder  User     @relation("RequestsByResponder", fields: [responderId], references: [id], onDelete: Cascade)
  questioner User     @relation("RequestsForQuestioner", fields: [questionerId], references: [id], onDelete: Cascade)
  messages   Message[]
  reviews    Review[]
  block      QuestionResponderBlock?
  transaction Transaction?

  @@unique([questionId, responderId])
  @@index([questionerId, status])
  @@index([responderId, status])
  @@map("answer_requests")
}

model QuestionResponderBlock {
  id              String    @id @default(uuid())
  questionId      String
  responderId     String
  answerRequestId String?   @unique
  rejectionReason String?
  createdAt       DateTime  @default(now())
  removedAt       DateTime?

  question      Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responder     User           @relation("ResponderBlocks", fields: [responderId], references: [id], onDelete: Cascade)
  answerRequest AnswerRequest? @relation(fields: [answerRequestId], references: [id], onDelete: SetNull)

  @@index([questionId])
  @@index([questionId, responderId])
  @@map("question_responder_blocks")
}

model Message {
  id             String      @id @default(uuid())
  questionId     String
  answerRequestId String
  senderId       String
  text           String
  type           MessageType @default(USER)
  visibleToUserId String?
  replyToId      String?
  createdAt      DateTime    @default(now())
  readAt         DateTime?

  question      Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerRequest AnswerRequest @relation(fields: [answerRequestId], references: [id], onDelete: Cascade)
  sender        User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo       Message?      @relation("MessageReplies", fields: [replyToId], references: [id])
  replies       Message[]     @relation("MessageReplies")

  @@index([questionId])
  @@index([answerRequestId])
  @@map("messages")
}

model Review {
  id              String        @id @default(uuid())
  answerRequestId String
  raterId         String
  rateeId         String
  raterRole       ReviewerRole
  stars           Int
  comment         String?
  isRevealed      Boolean       @default(false)
  createdAt       DateTime      @default(now())
  revealedAt      DateTime?

  answerRequest AnswerRequest @relation(fields: [answerRequestId], references: [id], onDelete: Cascade)
  rater         User          @relation("ReviewsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  ratee         User          @relation("ReviewsReceived", fields: [rateeId], references: [id], onDelete: Cascade)

  @@unique([answerRequestId, raterId])
  @@index([rateeId, isRevealed])
  @@map("reviews")
}

enum PaymentProvider {
  STRIPE
  PAYSTACK
}

enum PaymentAccountStatus {
  PENDING
  ONBOARDING
  ACTIVE
}

enum TransactionType {
  QUESTION_PAYMENT
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// Per-user payment identity with a provider. `customerId` identifies the
/// user as a payer (saved cards); `connectedAccountId` identifies them as a
/// payee (Stripe Connect account / Paystack subaccount) once payout
/// onboarding is complete. The provider is chosen from `currency`.
model PaymentAccount {
  id                 String               @id @default(uuid())
  userId             String               @unique
  provider           PaymentProvider
  currency           String
  customerId         String?
  connectedAccountId String?
  status             PaymentAccountStatus @default(PENDING)
  payoutsEnabled     Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_accounts")
}

/// Ledger of money movements. A QUESTION_PAYMENT row is created PENDING when
/// the questioner initiates payment and finalized SUCCEEDED/FAILED by the
/// provider webhook (or the client verify fallback). `providerRef` is unique
/// so webhook retries are idempotent.
model Transaction {
  id              String            @id @default(uuid())
  provider        PaymentProvider
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  amount          Float
  currency        String
  platformFee     Float             @default(0)
  payerId         String
  payeeId         String
  questionId      String?
  answerRequestId String?           @unique
  providerRef     String?           @unique
  failureReason   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  payer         User           @relation("PaymentsMade", fields: [payerId], references: [id], onDelete: Cascade)
  payee         User           @relation("PaymentsReceived", fields: [payeeId], references: [id], onDelete: Cascade)
  question      Question?      @relation(fields: [questionId], references: [id], onDelete: SetNull)
  answerRequest AnswerRequest? @relation(fields: [answerRequestId], references: [id], onDelete: SetNull)

  @@index([payerId, status])
  @@index([payeeId, status])
  @@map("transactions")
}

model UserRating {
  id           String     @id @default(uuid())
  userId       String
  role         RatingRole
  totalStars   Int
  reviewsCount Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_ratings")
}

/// Single-row table of tunable, market-wide runtime config.
/// Rows are keyed by `key` so future settings can be added without a migration
/// for each one. Keys include `nearMeRadiusKm` and `reviewRevealWindowDays`.
model MarketConfig {
  key   String @id
  value Float

  @@map("market_configs")
}
